---
import { sitePath } from "../lib/paths";
import ThemeSelect from "./ThemeSelect.astro";
---

<header class="site-header">
  <a class="brand" href={sitePath()}
    >SimpleMath<span class="brand-dot">.</span></a
  >
  <nav aria-label="Hauptnavigation">
    <a
      href={sitePath("simulationen/")}
      aria-current={Astro.url.pathname === sitePath("simulationen/")
        ? "page"
        : undefined}>Simulationen</a
    >
    <a href={sitePath("#downloads")}>Downloads</a>
  </nav>
  <ThemeSelect />
</header>
<style>
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    align-self: start;
    font-size: 1.15rem;
    font-weight: 750;
    text-decoration: none;
    color: var(--text);
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-right: 0.6rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--primary);
    font-size: 1.5rem;
  }
  .brand-dot {
    color: var(--primary);
  }
  nav {
    grid-row: 2;
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--primary);
  }
  .site-header :global(.theme-select) {
    grid-row: 1;
    grid-column: 2;
  }
  @media (min-width: 800px) {
    .site-header {
      grid-template-columns: 1fr auto auto;
      align-items: center;
      justify-content: space-between;
    }
    nav {
      grid-row: auto;
      grid-column: auto;
    }
    .site-header :global(.theme-select) {
      grid-column: 3;
    }
  }
</style>
