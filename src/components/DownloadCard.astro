---
import { isPdfAvailable, type DownloadFilename } from '../lib/downloads';
import { sitePath } from '../lib/paths';
interface Props {
  title: string;
  description: string;
  variants: { filename: DownloadFilename; label: string }[];
}
const { title, description, variants } = Astro.props;
const downloads = variants.map(variant => ({ ...variant, available: isPdfAvailable(variant.filename) }));
---
<article class="card download-card">
  <span class="file-type">PDF / {downloads.length > 1 ? `${downloads.length} VERSIONEN` : 'DOKUMENT'}</span>
  <h3>{title}</h3><p>{description}</p>
  <div class:list={['download-options', { 'multiple-versions': downloads.length > 1 }]}>
    {downloads.map(file => file.available
      ? <a class="button" href={sitePath(`downloads/${file.filename}`)} download>{file.label}<span aria-hidden="true">↓</span></a>
      : <span class="unavailable">{file.label} · noch nicht verfügbar</span>)}
  </div>
</article>
<style>
  .download-card { display: flex; flex-direction: column; align-items: flex-start; }
  .file-type { color: var(--primary); font: .7rem var(--mono); letter-spacing: .08em; margin-bottom: 1.2rem; }
  .download-card p { margin-top: 0; margin-bottom: 1.5rem; }
  .download-options { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: auto; }
  .multiple-versions a { background: var(--surface-raised); color: var(--primary); border-color: var(--border); }
  .multiple-versions a:hover { border-color: var(--primary); }
  .unavailable { color: var(--muted); font-size: .85rem; }
</style>
