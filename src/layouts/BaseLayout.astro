---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Ein Schulprojekt über numerische Verfahren für Differentialgleichungen.' } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} /><title>{title} | SimpleMath</title></head>
  <body><a class="skip-link" href="#inhalt">Zum Inhalt</a><div class="container">
    <Header /><main id="inhalt"><slot /></main><Footer />
  </div></body>
</html>
