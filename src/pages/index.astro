---
import BaseLayout from "../layouts/BaseLayout.astro";
import DownloadCard from "../components/DownloadCard.astro";
import { sitePath } from "../lib/paths";
---

<BaseLayout title="Approximation von Differentialgleichungen">
  <p class="eyebrow">Mathematik · interaktiv erleben</p>
  <h1>Approximation von gekoppelten Differentialgleichungen</h1>
  <p class="intro">
    Wie lässt sich eine Bewegung berechnen, wenn wir nur ihre Änderung kennen?
    Numerische Verfahren nähern Lösungen Schritt für Schritt an.
  </p>
  <p>
    Diese Website begleitet ein schulisches Mathematikprojekt. Am harmonischen
    Oszillator untersuchen wir, wie sich Schrittweite und Rechenverfahren auf
    die Genauigkeit auswirken.
  </p>
  <div class="cards">
    <article class="card">
      <h2>Theorie</h2><p>
        Von einer Gleichung zweiter Ordnung zu einem System erster Ordnung.
      </p><a href={sitePath("theorie/")}>Grundlagen lesen →</a>
    </article>
    <article class="card">
      <h2>Simulationen</h2><p>
        Fünf Verfahren mit der exakten Lösung vergleichen.
      </p><a href={sitePath("simulationen/")}>Oszillator untersuchen →</a>
    </article>
  </div>
  <section id="downloads">
    <h2>Material zum Projekt</h2><p>
      Poster und Skript zum Herunterladen. Aktuell enthalten die PDFs nur ihren
      Dateinamen als Funktionstest.
    </p>
    <div class="cards">
      <DownloadCard
        title="Poster"
        description="Das Projekt im Überblick. Als Druckversion oder für den Bildschirm."
        variants={[
          { filename: "poster_print.pdf", label: "Druckversion herunterladen" },
          {
            filename: "poster_digital.pdf",
            label: "Digitale Version herunterladen",
          },
        ]}
      />
      <DownloadCard
        title="Skript"
        description="Herleitungen und Erläuterungen zum Nachlesen."
        variants={[{ filename: "script.pdf", label: "Skript herunterladen" }]}
      />
    </div>
  </section>
</BaseLayout>
